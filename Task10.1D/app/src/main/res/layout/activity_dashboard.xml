<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="?android:attr/actionBarSize"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome, Student!"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/btnHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗝️ Get Hint for a Question"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/tvWelcome"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/btnExplain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Explain my Answer"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnHint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/btnSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 Summarise a Lesson"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnExplain"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/btnFlashcards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ Create 3 Flascards"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnSummary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/btnStudyPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📆 7-Day Study Plan"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnFlashcards"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/btnAssessment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎯 Adaptive Assessment"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnStudyPlan"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="📜 History"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnAssessment"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnSharing"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="📤 Share Profile"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnHistory"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnPurchase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="💰 Premium Upgrade"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnSharing"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="16dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>